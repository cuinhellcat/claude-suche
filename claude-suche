#!/bin/sh
''''[ -n "$MSYSTEM" ] && exec python "$0" "$@"
# Startzeilen fuer jede Shell (Linux, macOS, Git Bash unter Windows):
# die Shell sucht selbst einen Python-Interpreter; Python sieht hier nur Text.
command -v python3 >/dev/null 2>&1 && exec python3 "$0" "$@"
exec python "$0" "$@"
'''
# Durchsucht alle gespeicherten Claude-Code-Unterhaltungen nach Stichworten.
import json, os, re, sys, glob, datetime, argparse, locale, shutil, subprocess

BASE = os.path.expanduser("~/.claude")
PROJECTS = os.path.join(BASE, "projects")
HISTORY = os.path.join(BASE, "history.jsonl")


def teile_von(o):
    """Zerlegt eine Nachricht in (Quelle, Text)-Stücke.
    Quelle: DU, CLD (Claude), Werkzeug (Befehlsausgabe), System (Einblendungen)."""
    typ = o.get("type")
    c = (o.get("message") or {}).get("content")
    stuecke = []
    if isinstance(c, str):
        stuecke.append(("text", c))
    elif isinstance(c, list):
        for x in c:
            if not isinstance(x, dict):
                continue
            if x.get("type") == "text":
                stuecke.append(("text", x.get("text", "")))
            elif x.get("type") == "tool_result":
                r = x.get("content")
                stuecke.append(("werkzeug", r if isinstance(r, str) else json.dumps(r, ensure_ascii=False)))
    for art, t in stuecke:
        if not t:
            continue
        if art == "werkzeug":
            yield "Werkzeug", t
        elif typ == "assistant":
            yield "CLD", t
        elif o.get("isMeta") or t.lstrip().startswith("<"):
            yield "System", t
        else:
            yield "DU", t


def einzeilig(s, n=160):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[:n - 1] + "…"


def scan(path, pat, pats):
    """Liest eine Unterhaltung: Treffer, Metadaten und Verweise auf Vorgänger.
    Liefert immer ein Ergebnis, auch ohne Treffer (für Ketten nötig)."""
    m = dict(file=path, sid=os.path.basename(path)[:-6], first=None, last=None,
             cwd=None, titel=None, ai_titel=None, stand=None, letzte=None,
             hits=[], worte=set(), uuids=set(), eltern_uuids=[])
    seen = set()
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            typ = o.get("type")
            ts = o.get("timestamp")
            if ts:
                m["first"] = m["first"] or ts
                m["last"] = ts
            if o.get("uuid"):
                m["uuids"].add(o["uuid"])
            if m["cwd"] is None and o.get("cwd"):
                m["cwd"] = o["cwd"]
            if typ == "custom-title" and o.get("customTitle"):
                m["titel"] = o["customTitle"].strip() or m["titel"]
            elif typ == "ai-title" and o.get("aiTitle"):
                m["ai_titel"] = o["aiTitle"].strip() or m["ai_titel"]
            elif typ == "last-prompt" and o.get("lastPrompt"):
                m["letzte"] = o["lastPrompt"]
            elif typ == "system":
                if o.get("subtype") == "away_summary" and isinstance(o.get("content"), str):
                    m["stand"] = o["content"]
                elif o.get("subtype") == "compact_boundary" and o.get("logicalParentUuid"):
                    m["eltern_uuids"].append(o["logicalParentUuid"])
            if typ not in ("user", "assistant") or o.get("isCompactSummary"):
                continue  # Zusammenfassung wiederholt nur Altes -> nicht zählen
            for quelle, t in teile_von(o):
                for mt in pat.finditer(t):
                    a, b = max(0, mt.start() - 70), min(len(t), mt.end() + 70)
                    snip = " ".join(t[a:b].split())
                    if snip in seen:
                        continue
                    seen.add(snip)
                    m["hits"].append((quelle, ts or "", snip))
                    for i, p in enumerate(pats):
                        if p.search(mt.group(0)):
                            m["worte"].add(i)
    if not m["titel"]:
        m["titel"] = titel_aus_datei(path)
    return m


def titel_aus_datei(datei):
    """Älterer Ablageort des /rename-Namens: <session>/custom-title.json."""
    try:
        with open(os.path.join(datei[:-6], "custom-title.json"), encoding="utf-8") as fh:
            t = json.load(fh).get("customTitle")
            return t.strip() if isinstance(t, str) and t.strip() else None
    except Exception:
        return None


def ketten(metas):
    """Fasst Sitzungen zusammen, die per /compact in eine neue Datei gewandert sind.
    Liefert Einträge: das jüngste Glied plus alle Glieder in zeitlicher Folge."""
    uuid_zu_sid = {}
    for m in metas.values():
        for u in m["uuids"]:
            uuid_zu_sid.setdefault(u, m["sid"])
    eltern = {}
    kinder = {}
    for m in metas.values():
        for u in m["eltern_uuids"]:
            p = uuid_zu_sid.get(u)
            if p and p != m["sid"]:
                eltern.setdefault(m["sid"], p)
                kinder.setdefault(p, [])
                if m["sid"] not in kinder[p]:
                    kinder[p].append(m["sid"])
                break
    for p in kinder:
        kinder[p].sort(key=lambda s: metas[s]["first"] or "")

    def wurzel(s):
        besucht = set()
        while s in eltern and s not in besucht:
            besucht.add(s)
            s = eltern[s]
        return s

    gruppen = {}
    for sid in metas:
        gruppen.setdefault(wurzel(sid), None)

    eintraege = []
    for w in gruppen:
        glieder = []  # (sid, tiefe) in zeitlicher Folge (Tiefensuche)

        def lauf(s, tiefe, besucht):
            if s in besucht:
                return
            besucht.add(s)
            glieder.append((s, tiefe))
            for k in kinder.get(s, []):
                lauf(k, tiefe + 1, besucht)
        lauf(w, 0, set())
        ms = [metas[s] for s, _ in glieder]
        if not any(m["hits"] for m in ms):
            continue
        blaetter = [m for m in ms if m["sid"] not in kinder] or ms
        neu = max(blaetter, key=lambda m: m["last"] or "")
        eintraege.append(dict(
            neu=neu,
            glieder=[(metas[s], t) for s, t in glieder],
            n=sum(len(m["hits"]) for m in ms),
            worte=set().union(*(m["worte"] for m in ms)),
            von=min((m["first"] or "") for m in ms)[:10],
            bis=max((m["last"] or "") for m in ms)[:10],
        ))
    return eintraege


def name_von(e):
    neu = e["neu"]
    if neu["titel"] or neu["ai_titel"]:
        return neu["titel"] or neu["ai_titel"]
    for m, _ in reversed(e["glieder"]):
        if m["titel"] or m["ai_titel"]:
            return m["titel"] or m["ai_titel"]
    return None


def stand_von(e):
    for m in [e["neu"]] + [m for m, _ in reversed(e["glieder"])]:
        if m["stand"]:
            return m["stand"]
    for m in [e["neu"]] + [m for m, _ in reversed(e["glieder"])]:
        if m["letzte"]:
            return m["letzte"]
    return ""


def alle_funde(e):
    """Alle Funde der Kette in zeitlicher Folge (ältestes Glied zuerst)."""
    return [h for m, _ in e["glieder"] for h in m["hits"]]


def fundzeile(hits, i, n=400):
    """„3/165  [DU 2026-09-16]  …Text…“ für den Fund Nummer i."""
    if not hits:
        return "–"
    quelle, ts, snip = hits[i]
    return "%d/%d  [%s %s]  …%s…" % (i + 1, len(hits), quelle, ts[:10], einzeilig(snip, n))


def kopfzeile(e):
    zeit = e["von"] if e["von"] == e["bis"] else "%s bis %s" % (e["von"], e["bis"])
    teile = ""
    if len(e["glieder"]) > 1:
        teile = " (%s)" % "+".join(str(len(m["hits"])) for m, _ in e["glieder"])
    return "%d Treffer%s  %s" % (e["n"], teile, zeit)


def baumzeile(e, m, tiefe):
    name = m["titel"] or m["ai_titel"] or einzeilig(m["letzte"], 60) or m["sid"][:8]
    neu = "   ← neueste" if m is e["neu"] else ""
    return "%s└ %-4d %s  %s%s" % ("  " * tiefe, len(m["hits"]), (m["first"] or "")[:10], name, neu)


def hilfe():
    """Kurze Übersicht aller Befehle."""
    f = "\033[1m%s\033[0m"
    print(f % "claude-suche" + " — findet frühere Claude-Gespräche\n")
    zeilen = [
        ("claude-suche wort",        "Auswahlliste, Enter öffnet das Gespräch"),
        ("claude-suche wort1 wort2", "findet EINES der Wörter"),
        ("claude-suche -t wort1 wort2", "findet nur, wo ALLE Wörter vorkommen"),
        ("claude-suche -l wort",     "nur ausdrucken, keine Auswahl"),
        ("claude-suche -v wort",     "Fundstellen im Text zeigen"),
        ("claude-suche -p wort",     "auch alte, gelöschte Gespräche"),
        ("claude-suche -h",          "diese Übersicht (auch -? oder --help)"),
    ]
    breite = max(len(a) for a, _ in zeilen)
    for befehl, was in zeilen:
        print("  " + (f % befehl.ljust(breite)) + "   " + was)
    print("\nIn der Auswahlliste:")
    print("  ↑ ↓ / Bild-hoch / Bild-runter / Pos1 / Ende   wählen")
    print("  ← →     springt durch die Funde (älter / neuer)")
    print("  Enter   öffnet das Gespräch im richtigen Ordner")
    print("  e       klappt eine Kette auf/zu (erkennbar an „(111+11+1)“)")
    print("  q       bricht ab\n")
    print("Eine Kette entsteht, wenn /compact das Gespräch in einer neuen Datei")
    print("fortsetzt. Angezeigt wird das neueste Glied, gezählt werden alle.\n")
    print("Hinweis: Manche Konsolen verschlucken das Fragezeichen.")
    print("Dann \"-?\" in Anführungszeichen schreiben.")


def waehle(eintraege, worte):
    """Zeigt die Treffer als Liste. Pfeiltasten + Enter, e klappt Ketten auf.
    Gibt die gewählte Sitzung zurück, None bei Abbruch,
    False wenn keine Auswahlliste möglich ist (curses fehlt)."""
    try:
        import curses
    except ImportError:
        print("Hinweis: Auswahlliste braucht das Modul curses.")
        if os.name == "nt":
            print("         Unter Windows:  pip install windows-curses")
        print("         Bis dahin nur die Liste:\n")
        return False

    for e in eintraege:
        e["_name"] = name_von(e)
        e["_stand"] = einzeilig(stand_von(e), 400)
        e["_funde"] = alle_funde(e)
    offen = set()
    fundpos = {}  # (eintrag, sitzung oder None) -> Index; fehlt = neuester Fund

    def funde_fuer(i, m):
        """Funde des Kopfes (ganze Kette) oder eines einzelnen Glieds."""
        return eintraege[i]["_funde"] if m is None else m["hits"]

    def fund_index(i, m):
        hits = funde_fuer(i, m)
        return min(fundpos.get((i, m and m["sid"]), len(hits) - 1), len(hits) - 1)

    def lauf(scr):
        curses.curs_set(0)
        scr.keypad(True)
        try:
            curses.set_escdelay(25)
        except Exception:
            pass
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        pos = 0   # Index in die wählbaren Punkte
        oben = 0
        while True:
            # wählbare Punkte: (eintrag, sitzung); Kopf = neuestes Glied
            punkte = []
            for i, e in enumerate(eintraege):
                punkte.append((i, e["neu"]))
                if i in offen:
                    punkte.extend((i, m) for m, _ in e["glieder"])
            pos = max(0, min(pos, len(punkte) - 1))
            akt_i, akt_m = punkte[pos]
            auf_kopf = pos == 0 or punkte[pos - 1][0] != akt_i

            scr.erase()
            h, b = scr.getmaxyx()
            scr.addnstr(0, 0, "%d Gespräche zu: %s" % (len(eintraege), " ".join(worte)),
                        b - 1, curses.A_BOLD)
            scr.addnstr(1, 0, "↑↓ wählen · ←→ Funde · Enter öffnet · e Kette auf/zu · q bricht ab",
                        b - 1, curses.A_DIM)
            # welches Glied liefert gerade die Funde? Kopf = ganze Kette
            glied_gewaehlt = None if auf_kopf else akt_m

            zeilen = []
            sel_start = sel_len = 0
            for i, e in enumerate(eintraege):
                start = len(zeilen)
                kopf_gewaehlt = i == akt_i and auf_kopf
                mark = "> " if kopf_gewaehlt else "  "
                zeilen.append((mark + kopfzeile(e),
                               curses.A_REVERSE if kopf_gewaehlt else curses.A_BOLD))
                if e["_name"]:
                    zeilen.append(("    Name   : " + e["_name"],
                                   curses.A_BOLD if i == akt_i else 0))
                zeilen.append(("    Ordner : " + (e["neu"]["cwd"] or "?"), 0))
                if e["_stand"]:
                    zeilen.append(("    Stand  : " + e["_stand"], curses.A_DIM))
                fm = glied_gewaehlt if i == akt_i else None
                zeilen.append(("    Fund   : " + fundzeile(funde_fuer(i, fm), fund_index(i, fm)),
                               0 if i == akt_i else curses.A_DIM))
                if i in offen:
                    for m, tiefe in e["glieder"]:
                        gew = i == akt_i and not auf_kopf and m is akt_m
                        if gew:
                            sel_start, sel_len = len(zeilen), 1
                        zeilen.append((("  > " if gew else "    ") + baumzeile(e, m, tiefe),
                                       curses.A_REVERSE if gew else 0))
                zeilen.append(("", 0))
                if kopf_gewaehlt:
                    sel_start, sel_len = start, len(zeilen) - start

            platz = max(1, h - 3)
            if sel_start < oben:
                oben = sel_start
            if sel_start + sel_len > oben + platz:
                oben = min(sel_start, sel_start + sel_len - platz)
            oben = max(0, min(oben, max(0, len(zeilen) - platz)))

            for j in range(oben, min(len(zeilen), oben + platz)):
                text, attr = zeilen[j]
                if text:
                    scr.addnstr(3 + j - oben, 0, text, b - 1, attr)
            scr.refresh()

            k = scr.getch()
            if k == 27:  # Notfall: rohe Pfeiltasten-Folge (ESC [ A/B)
                scr.nodelay(True)
                folge = [scr.getch(), scr.getch()]
                scr.nodelay(False)
                if folge[0] in (ord("["), ord("O")):
                    k = {ord("A"): curses.KEY_UP, ord("B"): curses.KEY_DOWN,
                         ord("C"): curses.KEY_RIGHT, ord("D"): curses.KEY_LEFT,
                         ord("H"): curses.KEY_HOME, ord("F"): curses.KEY_END}.get(folge[1], -1)
                elif folge[0] == -1:
                    return None  # ESC allein = Abbruch
            if k in (curses.KEY_DOWN, ord("j")):
                pos += 1
            elif k in (curses.KEY_UP, ord("k")):
                pos -= 1
            elif k == curses.KEY_HOME:
                pos = 0
            elif k == curses.KEY_END:
                pos = len(punkte) - 1
            elif k == curses.KEY_NPAGE:
                pos += 5
            elif k == curses.KEY_PPAGE:
                pos -= 5
            elif k in (curses.KEY_LEFT, curses.KEY_RIGHT):
                hits = funde_fuer(akt_i, glied_gewaehlt)
                if hits:
                    schritt = -1 if k == curses.KEY_LEFT else 1
                    neu_i = max(0, min(len(hits) - 1, fund_index(akt_i, glied_gewaehlt) + schritt))
                    fundpos[(akt_i, glied_gewaehlt and glied_gewaehlt["sid"])] = neu_i
            elif k == ord("e"):
                if akt_i in offen:
                    offen.discard(akt_i)
                    pos = next(j for j, p in enumerate(punkte) if p[0] == akt_i)
                elif len(eintraege[akt_i]["glieder"]) > 1:
                    offen.add(akt_i)
            elif k in (10, 13, curses.KEY_ENTER):
                return akt_m
            elif k == ord("q"):
                return None

    return curses.wrapper(lauf)


def oeffne(m):
    """Wechselt in den Ordner des Gesprächs und startet claude --resume."""
    sid = m["sid"]
    ordner = m.get("cwd")
    if ordner and os.path.isdir(ordner):
        os.chdir(ordner)
    else:
        ordner = os.getcwd()
    print("Öffne %s\n  in %s" % (m["titel"] or m["ai_titel"] or sid, ordner))
    sys.stdout.flush()
    exe = shutil.which("claude")
    if not exe:
        print("Fehler: 'claude' nicht gefunden. Von Hand:  claude --resume " + sid)
        return 1
    if os.name == "nt":
        try:
            return subprocess.call([exe, "--resume", sid])
        except KeyboardInterrupt:
            return 130
    os.execvp(exe, [exe, "--resume", sid])


def main():
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    if os.name == "nt":
        os.system("")  # schaltet Farbcodes in der Windows-Konsole frei
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("-t", "--alle", action="store_true", help="alle Wörter müssen vorkommen")
    ap.add_argument("-v", "--volltext", action="store_true", help="Fundstellen anzeigen")
    ap.add_argument("-p", "--prompts", action="store_true", help="auch alte Eingaben durchsuchen")
    ap.add_argument("-l", "--liste", action="store_true", help="nur auflisten, keine Auswahl")
    ap.add_argument("-h", "--help", "-?", "--?", dest="help", action="store_true")
    ap.add_argument("worte", nargs="*")
    a = ap.parse_args()
    if a.help or not a.worte:
        hilfe()
        return 0

    pats = [re.compile(re.escape(w), re.I) for w in a.worte]
    pat = re.compile("|".join(re.escape(w) for w in a.worte), re.I)

    metas = {}
    for f in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        if os.sep + "memory" + os.sep in f:
            continue
        try:
            m = scan(f, pat, pats)
        except Exception:
            continue
        metas[m["sid"]] = m

    eintraege = ketten(metas)
    if a.alle:
        eintraege = [e for e in eintraege if len(e["worte"]) == len(pats)]
    eintraege.sort(key=lambda e: e["n"], reverse=True)

    if eintraege and sys.stdout.isatty() and sys.stdin.isatty() \
            and not (a.liste or a.volltext or a.prompts):
        m = waehle(eintraege, a.worte)
        if m is None:
            return 0
        if m is not False:
            return oeffne(m)

    if not eintraege:
        print("Keine Unterhaltung gefunden.")
    for e in eintraege:
        neu = e["neu"]
        name = name_von(e)
        stand = einzeilig(stand_von(e))
        print(f"\n\033[1m{kopfzeile(e)}\033[0m")
        if name:
            print(f"  Name   : \033[1m{name}\033[0m")
        print(f"  Ordner : {neu['cwd'] or '?'}")
        if stand:
            print(f"  Stand  : {stand}")
        funde = alle_funde(e)
        print(f"  Fund   : {fundzeile(funde, len(funde) - 1, 160)}")
        print(f"  Öffnen : claude --resume {neu['sid']}")
        if len(e["glieder"]) > 1:
            print("  Kette  :")
            for m, tiefe in e["glieder"]:
                print(f"    {baumzeile(e, m, tiefe)}   (claude --resume {m['sid']})")
        if a.volltext:
            for m, _ in e["glieder"]:
                for quelle, ts, snip in m["hits"][:6]:
                    print(f"    [{quelle} {ts[:10]}] …{snip}…")

    if a.prompts and os.path.exists(HISTORY):
        print("\n\033[1m--- Eigene Eingaben (auch aus gelöschten Gesprächen) ---\033[0m")
        have = set(metas)
        for line in open(HISTORY, encoding="utf-8", errors="replace"):
            try:
                o = json.loads(line)
            except Exception:
                continue
            d = o.get("display", "")
            if a.alle:
                if not all(p.search(d) for p in pats):
                    continue
            elif not pat.search(d):
                continue
            ts = o.get("timestamp")
            when = datetime.datetime.fromtimestamp(ts / 1000).strftime("%Y-%m-%d %H:%M") if ts else "?"
            weg = "" if o.get("sessionId") in have else "  \033[31m[Gespräch gelöscht]\033[0m"
            print(f"  {when}{weg}\n    {' '.join(d.split())[:200]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
